      ]
    },
    "7a. Enregistrement registre (Google Sheets)": {
      "main": [[{ "node": "8. Archivage photo/PDF (Google Drive)", "type": "main", "index": 0 }]]
    },
    "8. Archivage photo/PDF (Google Drive)": {
      "main": [[{ "node": "9. IF anomalie signalee", "type": "main", "index": 0 }]]
    },
    "9. IF anomalie signalee": {
      "main": [[{ "node": "9a. Alerte anomalie dirigeant", "type": "main", "index": 0 }], []]
    },
    "10. Cron hebdomadaire (vendredi 17h)": {
      "main": [[{ "node": "11. Lecture registre semaine", "type": "main", "index": 0 }]]
    },
    "11. Lecture registre semaine": {
      "main": [[{ "node": "12. Agregation par site/contrat", "type": "main", "index": 0 }]]
    },
    "12. Agregation par site/contrat": {
      "main": [[{ "node": "13. Envoi recap dirigeant", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
